# Production Environment Variables for Render
# Copy this file to .env and fill in the actual values for your Render deployment

# Database Configuration
# Get this from your Render PostgreSQL database dashboard
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Session Secret - Use a strong random string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_strong_random_session_secret_here

# Port - Render assigns this, typically 10000
PORT=10000

# Node Environment
NODE_ENV=production
